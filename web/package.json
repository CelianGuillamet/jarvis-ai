{
  "name": "jarvis-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5173 --strictPort",
    "build": "vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "vue-tsc --noEmit",
    "test": "node --experimental-strip-types --test test/*.test.mjs",
    "lint": "eslint src vite.config.ts test",
    "lint:fix": "npm run lint -- --fix",
    "prototype": "vite --mode prototype --port 5174 --strictPort",
    "build:prototype": "vite build --mode prototype"
  },
  "dependencies": {
    "dompurify": "^3.4.15",
    "marked": "^18.0.2",
    "pinia": "^2.2.8",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-vue": "^6.0.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^10.11.0",
    "eslint-plugin-vue": "^10.11.0",
    "globals": "^16.5.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^6.2.0",
    "vue-tsc": "^2.2.10"
  },
  "engines": {
    "node": ">=24.11.0 <25",
    "npm": ">=11 <12"
  }
}
