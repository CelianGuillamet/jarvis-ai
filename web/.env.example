# Optional public configuration. Never put secrets in VITE_* values.
# Empty API base uses relative URLs and the Vite development proxy.
VITE_API_BASE_URL=
VITE_API_PROXY_TARGET=http://localhost:3000
VITE_DEFAULT_SESSION_ID=default
VITE_REQUEST_TIMEOUT_MS=60000
VITE_BASE_PATH=/
# Vite empties this build-output directory; keep it separate from source/data.
VITE_OUT_DIR=dist
