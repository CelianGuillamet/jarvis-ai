# Local development only. Enables /dev/ assets; use production for a release.
NODE_ENV=development
PORT=3000
# Simulation does not cover every existing entry point; use test accounts/data.
SIMULATION=true
# Local default: install Ollama and pull this model before model-backed chat.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:latest
PENDING_TTL_MINUTES=10
# Optional until connecting Google. Register GOOGLE_REDIRECT_URI exactly.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="http://localhost:3000/auth/google/callback"
# Required before integration authorization or legacy-token maintenance.
# JSON map of key IDs to independent random 32-byte base64 keys; never commit keys.
# See docs/security/google-authorization.md for local storage, backup and rotation.
GOOGLE_TOKEN_KEYS='{}'
GOOGLE_TOKEN_ACTIVE_KEY=
CONVO_TTL_MINUTES=10

# Required for running the API/migrations; matches docker-compose.yml.
DATABASE_URL="postgresql://jarvis:password@localhost:5432/jarvis?schema=public"

HUMANIZE_RESPONSES=true
JARVIS_DEFAULT_SPEECH_MODE=tu
JARVIS_DEFAULT_VERBOSITY=normal
HUMAN_PROFILE_PERSIST=true
HUMAN_PROFILE_TTL_MINUTES=1440
HUMAN_PROFILE_MAX_SESSIONS=5000
HUMAN_PROFILE_FLUSH_INTERVAL_MS=5000
HUMAN_PROFILE_MIN_PERSIST_INTERVAL_MS=1500

# Select openai and fill the key only if using a hosted model.
LLM_PROVIDER=ollama
OPENAI_API_KEY=
OPENAI_MODEL_PRIMARY=gpt-5-nano
OPENAI_MODEL_FALLBACK=gpt-5-mini
OPENAI_TIMEOUT_MS=30000
MODEL_TOTAL_DEADLINE_MS=45000
MODEL_MAX_OUTPUT_TOKENS=8192
MODEL_USER_DAILY_CALLS=300
MODEL_GLOBAL_DAILY_CALLS=2000
# OPENAI_BASE_URL=https://api.openai.com/v1

# Web search/page retrieval are disabled for the private beta (JAR-006).
# Legacy WEB_*, GOOGLE_SEARCH_* and SERPER_* settings cannot enable retrieval.
# Developer assets under /dev/ are served only with NODE_ENV=development.

# Application login is distinct from Gmail/Calendar authorization above.
# Generate AUTH_SECRET locally with: openssl rand -base64 32
AUTH_SECRET=
AUTH_BASE_URL=http://localhost:3000
APP_ORIGIN=http://localhost:5173
# Optional locally: without these, Google sign-in remains unavailable.
# Register callback http://localhost:3000/api/auth/callback/google for this client.
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=

# Privacy erasure + retention scheduler; tests drive these jobs explicitly.
# false pauses both cleanup and erasure processing for maintenance.
PRIVACY_WORKER_ENABLED=true

# Persist deletion ledger outside database dump/restore targets; directory mode0700.
# PRIVACY_LEDGER_DIR=/absolute/protected/jarvis-ledger
# Optional independent AES256 key ring for staged rotation. Preserve old keys.
# PRIVACY_LEDGER_KEYS={"ledger-v1":"BASE64_32_BYTE_KEY"}
# PRIVACY_LEDGER_ACTIVE_KEY=ledger-v1
# Without a ring, the ledger key is derived from AUTH_SECRET; retain it for replay.

# Hosted beta reads and writes Google Calendar only. Set true to use the unfinished local calendar when Google is not connected.
CALENDAR_LOCAL_FALLBACK=false
